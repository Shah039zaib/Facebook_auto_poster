# =============================
# FB AI Poster - Environment Variables
# =============================

# Groq API Key (Free - console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Facebook Config (developers.facebook.com)
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FB_PAGE_ID=your_facebook_page_id

# App Config
PORT=3000
NODE_ENV=production

# Admin Password (Dashboard login ke liye)
ADMIN_PASSWORD=admin123
